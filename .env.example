# Copy to .env and fill in. .env is git-ignored; never commit real values.

# ---- Required for live investigations (LLM synthesis) ----
# Get a key at https://console.groq.com
GROQ_API_KEY=your-key-here

# ---- Required only for the ingestion scripts (SEC/OFAC/CourtListener) ----
# SEC and OFAC reject requests without a real contact identity.
CONTACT_USER_AGENT=Your Name your.email@example.com
# Optional; raises CourtListener rate limits.
COURTLISTENER_API_TOKEN=

# ---- Storage (all optional; defaults are relative to the repo root) ----
# CHROMA_PERSIST_DIR=vectorstore/chroma_db
# DATA_DIR=data/processed
# CORPUS_PATH=data/processed/corpus_final.jsonl
# CHROMA_COLLECTION=osint_entity_corpus
# Per-request trace JSON files. Set empty to disable (recommended when hosted).
# TRACE_DIR=logs/traces

# ---- Models (optional) ----
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# LLM_MODEL=openai/gpt-oss-120b
# LLM_TIMEOUT_SECONDS=30
# TOP_K=5

# ---- API (optional) ----
# Comma-separated, explicit origins; '*' is refused.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Per client IP; 0 disables.
RATE_LIMIT_PER_MINUTE=10
# Only true behind a proxy that sets X-Forwarded-For and strips client-supplied values.
TRUST_PROXY_HEADERS=false
# off = live agent; prerecorded = replay saved responses (no LLM key or index needed)
DEMO_MODE=off
